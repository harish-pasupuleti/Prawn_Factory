# Copy to apps/api/.env (development) and apps/api/.env.test (tests). NEVER commit real values.
NODE_ENV=development
PORT=5000

# ---- Database: Neon PostgreSQL (free plan) -------------------------------------------------
# DATABASE_URL = POOLED connection string (host contains "-pooler"). Used by the running API.
# DIRECT_URL   = DIRECT connection string (no "-pooler"). Used by Prisma migrations.
# Copy both from Neon: project dashboard > Connect > toggle "Connection pooling" on/off.
# Keep sslmode=require. connect_timeout=15 gives a sleeping (scaled-to-zero) Neon database time to wake up.
# If Neon adds channel_binding=require to the string, delete that part.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
DIRECT_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
# (Local PostgreSQL also works: set both to postgresql://USER:PASSWORD@localhost:5432/DBNAME for both variables.)

# At least 32 random characters. Generate with the PowerShell command in the README.
JWT_ACCESS_SECRET=replace-with-random-value-at-least-32-chars

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
# true only when running behind exactly one trusted reverse proxy (needed for correct per-IP rate limiting)
TRUST_PROXY=false
LOG_LEVEL=info
FACTORY_TIMEZONE=Asia/Kolkata
# Percent difference between declared / inspected / collected quantities above which a written explanation is required
QUANTITY_VARIANCE_THRESHOLD_PCT=10
# Reception: percent difference between the received (net) weight and the collected quantity above which an exception is raised
RECEPTION_VARIANCE_THRESHOLD_PCT=5
# Processing target = received tonnes x PROCESSING_MINUTES_PER_TONNE, never less than PROCESSING_MIN_MINUTES
PROCESSING_MINUTES_PER_TONNE=120
PROCESSING_MIN_MINUTES=30
# A vehicle may be admitted without a manager's override from this many minutes before its slot starts until this many after it ends
GATE_EARLY_GRACE_MIN=60
GATE_LATE_GRACE_MIN=30
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=5

# Only used by `npm run db:seed` (set them in the shell instead; see README). Leave empty here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
